# RackSense Backend Environment Configuration
CONTRACT_VERSION=1.0.0
SITE_ID=site-01
DB_PATH=backend/data/racksense.db

# Mosquitto Broker Configuration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=change_this_secret_in_real_env
MQTT_KEEPALIVE=60

# Logging
LOG_LEVEL=INFO

# AI Configuration (Advisory only)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

